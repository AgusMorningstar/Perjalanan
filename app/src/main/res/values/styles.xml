<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- CIRCLE -->
    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- HEADER TEXT -->
    <style name="Text.Header" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- BUTTON -->
    <style name="Widget.App.Button"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/maroon</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>

    </style>

    <!-- OUTLINE BUTTON -->
    <style name="Widget.App.Button.Outline"
        parent="Widget.MaterialComponents.Button.OutlinedButton">

        <item name="strokeColor">@color/maroon</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/maroon</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>

    </style>

    <!-- INPUT -->
    <style name="Widget.App.Input"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">@color/maroon</item>
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/maroon</item>
        <item name="endIconTint">@color/text_gray</item>

    </style>

</resources>
