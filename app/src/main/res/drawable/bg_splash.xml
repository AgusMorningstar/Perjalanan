<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/maroon_dark"
                android:centerColor="@color/maroon"
                android:endColor="#64121C"/>
        </shape>
    </item>

    <item
        android:gravity="top|left"
        android:drawable="@drawable/bg_wave_top"/>

    <item
        android:gravity="bottom|right"
        android:drawable="@drawable/bg_wave_bottom"/>

</layer-list>
