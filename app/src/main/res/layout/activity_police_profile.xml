<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F1"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:background="#800D19">

            <ImageView
                android:id="@+id/btnPoliceProfileBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="Kembali"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Profil Polisi"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/btnPoliceProfileSettings"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_settings"
                app:tint="#FFFFFF"
                android:contentDescription="Pengaturan"/>

        </LinearLayout>

        <!-- PROFIL PETUGAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#800D19"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <FrameLayout
                android:layout_width="105dp"
                android:layout_height="105dp">

                <ImageView
                    android:id="@+id/imgPoliceProfile"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    android:padding="22dp"
                    android:background="@drawable/bg_badge"
                    app:tint="#800D19"
                    android:contentDescription="Foto petugas"/>

            </FrameLayout>

            <TextView
                android:id="@+id/tvPoliceProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Petugas Unit 07"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPoliceProfileRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="PETUGAS KEPOLISIAN"
                android:textColor="#F5D8D8"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvPoliceProfileOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_badge"
                android:text="● ONLINE"
                android:textColor="#188B50"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- STATUS PETUGAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="10dp"
                android:src="@drawable/ic_shield"
                android:background="@drawable/bg_badge"
                app:tint="#800D19"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status Tugas"
                    android:textColor="#888888"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvPoliceDutyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siaga"
                    android:textColor="#188B50"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AKTIF"
                android:textColor="#188B50"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- INFORMASI PETUGAS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:text="Informasi Petugas"
            android:textColor="#32191B"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nomor Identitas"
                android:textColor="#888888"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvPoliceIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="POL-007"
                android:textColor="#32191B"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="13dp"
                android:background="#EEEEEE"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#888888"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvPoliceEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="polisi.unit07@gmail.com"
                android:textColor="#32191B"
                android:textSize="14sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="13dp"
                android:background="#EEEEEE"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nomor Telepon"
                android:textColor="#888888"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvPolicePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="081234567890"
                android:textColor="#32191B"
                android:textSize="14sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="13dp"
                android:background="#EEEEEE"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unit Kepolisian"
                android:textColor="#888888"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvPoliceUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Unit Polisi 07"
                android:textColor="#32191B"
                android:textSize="14sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="13dp"
                android:background="#EEEEEE"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kantor Penugasan"
                android:textColor="#888888"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvPoliceOffice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kantor Polisi Unit 07"
                android:textColor="#32191B"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- PERANGKAT ALARM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:text="Perangkat Keamanan"
            android:textColor="#32191B"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_badge"
                    android:src="@drawable/ic_bell"
                    app:tint="#800D19"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alarm SOS"
                        android:textColor="#32191B"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvPoliceAlarmConnection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Perangkat terhubung"
                        android:textColor="#188B50"
                        android:textSize="11sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPoliceAlarmStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AKTIF"
                    android:textColor="#188B50"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#EEEEEE"/>

            <LinearLayout
                android:id="@+id/btnPoliceAlarmSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pengaturan Alarm"
                    android:textColor="#32191B"
                    android:textSize="13sp"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#888888"/>

            </LinearLayout>

        </LinearLayout>

        <!-- MENU AKUN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:text="Pengaturan Akun"
            android:textColor="#32191B"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnPoliceEditProfile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="15dp"
                android:text="Edit Profil"
                android:textColor="#32191B"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"/>

            <TextView
                android:id="@+id/btnPoliceChangePassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="15dp"
                android:text="Ubah Password"
                android:textColor="#32191B"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"/>

            <TextView
                android:id="@+id/btnPoliceLogout"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:drawableStart="@drawable/ic_logout"
                android:drawablePadding="15dp"
                android:text="Logout"
                android:textColor="#C2182B"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:text="Perjalanan • Dashboard Polisi"
            android:textColor="#999999"
            android:textSize="10sp"/>

    </LinearLayout>

</ScrollView>