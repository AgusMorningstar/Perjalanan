<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sosDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_sos_dialog"
    android:padding="12dp">

    <!-- IKON SOS -->
    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_sos_outer_circle"
        android:gravity="center">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_sos_middle_circle"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgSosIcon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sos_warning"
                android:contentDescription="Peringatan SOS" />

        </FrameLayout>
    </FrameLayout>

    <!-- LABEL -->
    <TextView
        android:id="@+id/tvSosLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_sos_label"
        android:text="SINYAL SOS - PRIORITAS TINGGI"
        android:textColor="#C01828"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- JUDUL -->
    <TextView
        android:id="@+id/tvSosTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="Laporan darurat baru"
        android:textColor="#48121B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- LOKASI -->
    <TextView
        android:id="@+id/tvSosLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="Salsabilaa · Jl. Pendidikan No.12"
        android:textColor="#998D8D"
        android:textSize="10sp" />

    <!-- INFORMASI DARURAT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- JARAK -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_sos_info"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSosDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,8 km"
                android:textColor="#48121B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSosDistanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jarak"
                android:textColor="#998D8D"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- ESTIMASI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_sos_info"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSosTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 mnt"
                android:textColor="#48121B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSosTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimasi"
                android:textColor="#998D8D"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- DETAK -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_sos_info"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSosExtra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="128 bpm"
                android:textColor="#48121B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSosExtraLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detak"
                android:textColor="#998D8D"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- TOMBOL TERIMA DAN LIHAT LOKASI -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSosAction"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="Terima &amp; Lihat Lokasi"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#8A101E"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_sos_location"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="18dp" />

    <!-- TOMBOL MATIKAN ALARM -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSosMuteAlarm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="Matikan Alarm"
        android:textColor="#8A101E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#FCE7E8"
        android:visibility="visible"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_alarm_off"
        app:iconTint="#8A101E"
        app:iconGravity="textStart"
        app:iconSize="18dp" />

    <!-- TOMBOL NANTI -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSosLater"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="Nanti"
        android:textColor="#8A101E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF"
        app:cornerRadius="12dp"
        app:strokeColor="#8A101E"
        app:strokeWidth="1dp" />

</LinearLayout>